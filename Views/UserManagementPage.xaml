<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelApp.Views.UserManagementPage"
             Title="User Management">

    <ScrollView>
        <VerticalStackLayout Padding="12" Spacing="10">
            <!-- quick admin helper -->
            <Button Text="Create demo admin" Command="{Binding CreateAdminCommand}" />

            <!-- Create user form -->
            <Frame Padding="10" BorderColor="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Create new user" FontAttributes="Bold" />
                    <Entry Placeholder="Username" Text="{Binding Username}" />
                    <Entry Placeholder="Full name" Text="{Binding FullName}" />
                    <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                    <Label Text="Role" />
                    <Picker ItemsSource="{Binding Roles}" ItemDisplayBinding="{Binding RoleName}" SelectedItem="{Binding SelectedRole}" />
                    <Button Text="Create user" Command="{Binding CreateUserCommand}" />
                </VerticalStackLayout>
            </Frame>

            <!-- Existing users list -->
            <CollectionView ItemsSource="{Binding Users}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Padding="8" Margin="4">
                            <VerticalStackLayout>
                                <Label Text="{Binding Username}" FontAttributes="Bold" />
                                <Label Text="{Binding FullName}" FontSize="12" />
                                <Label Text="{Binding Role.RoleName}" FontSize="12" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>