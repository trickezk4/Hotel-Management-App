<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelApp.Views.LoginPage"
             Title="Login">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
            <Label Text="Login" FontAttributes="Bold" FontSize="20" HorizontalOptions="Center" />
            <Entry Placeholder="Username" Text="{Binding Username}" />
            <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
            <Button Text="Sign in" Command="{Binding LoginCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>